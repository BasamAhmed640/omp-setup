68-export function currentReviewSnapshots(section: import("./types.ts").ScholarSection, sourceHash: string): ScholarSnapshot[] {
69-  const ids = new Set(validLessonEntries(section, sourceHash).flatMap(entry => entry.lesson!.embeddedSnapshotIds || []));
70-  for (const page of section.figureCoverage?.pages || []) {
71-    for (const figure of page.review?.figures || []) if (figure.snapshotId) ids.add(figure.snapshotId);
72-  }
73-  return (section.snapshots || []).filter(snapshot => ids.has(snapshot.id));
74-}
